<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.example.intent</groupId>
	<artifactId>intent-api-spec</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>intent-api-spec</name>
	<description>Intent API OpenAPI Specification</description>

	<build>
		<resources>
			<resource>
				<!-- Package the bundled single-file spec produced by the bundle step below -->
				<directory>${project.build.directory}/spec</directory>
				<includes>
					<include>openapi.yaml</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<id>bundle-api-spec</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>npx</executable>
							<arguments>
								<argument>@redocly/cli</argument>
								<argument>bundle</argument>
								<argument>openapi.yaml</argument>
								<argument>--output</argument>
								<argument>${project.build.directory}/spec/openapi.yaml</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/iamalokit/intent-api-spec</url>
		</repository>
	</distributionManagement>

</project>
