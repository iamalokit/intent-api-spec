{
  "name": "@silver/backend-api",
  "version": "3.1.0",
  "description": "OpenAPI specification for Silver Backend Service",
  "files": [
    "dist/openapi.yaml"
  ],
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "build": "redocly bundle openapi.yaml -o dist/openapi.yaml",
    "build:docs": "redocly build-docs openapi.yaml -o dist/index.html",
    "preview": "redocly preview-docs openapi.yaml --port 8082",
    "publish:maven": "node scripts/publish-maven.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0"
  }
}
