{
  "name": "@silver/backend-api",
  "version": "3.2.0",
  "description": "OpenAPI specification for Silver Backend Service",
  "files": [
    "dist/openapi.yaml"
  ],
  "scripts": {
    "lint": "redocly lint v2",
    "build": "redocly bundle v2 -o dist/openapi.yaml",
    "build:docs": "redocly build-docs v2 -o dist/index.html",
    "preview": "redocly preview --product redoc --port 8082",
    "publish:maven": "node scripts/publish-maven.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@redocly/cli": "^2.47.0"
  }
}
